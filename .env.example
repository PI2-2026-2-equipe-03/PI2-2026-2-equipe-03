# variáveis do compose central. copie para .env e ajuste.
# o compose também monta este arquivo como .env.local do frontend; só as vars
# com prefixo VITE_ chegam ao browser.

# bd
POSTGRES_DB=tagravado
POSTGRES_USER=tagravado
POSTGRES_PASSWORD=tagravado
# porta do postgres no host; troque se já tiver postgres rodando em 5432.
POSTGRES_PORT=5432

# back
BACKEND_PORT=3000
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-in-env
DB_POOL_MAX=10

# front
FRONTEND_PORT=5173
# o spa chama /api/* e o vite proxia para o backend (evita cors).
VITE_API_URL=/api
# false = usa a api real; true = usa mocks em src/lib/api/mocks.
VITE_USE_MOCKS=false
# alvo do proxy do vite na rede do compose.
API_PROXY_TARGET=http://backend:3000
