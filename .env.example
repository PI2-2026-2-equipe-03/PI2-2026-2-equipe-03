# Variáveis do docker-compose.yml central.
# Copie para .env (git-ignorado) e ajuste conforme necessário.

# bd
POSTGRES_DB=tagravado
POSTGRES_USER=tagravado
POSTGRES_PASSWORD=tagravado
POSTGRES_PORT=5432

# back
BACKEND_PORT=3000
NODE_ENV=development
JWT_SECRET=change-me

# front
FRONTEND_PORT=5173

# URL usada pelo navegador (não pelo container) para chamar a API.
# Em execução conjunta via compose central, o backend fica exposto em localhost:3000.
VITE_API_URL=http://localhost:3000
